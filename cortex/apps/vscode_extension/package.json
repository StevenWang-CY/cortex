{
  "name": "cortex-somatic",
  "displayName": "Cortex — Workspace Support",
  "description": "Local workspace context and conservative, user-controlled support proposals.",
  "version": "0.4.0",
  "publisher": "cortex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StevenWang-CY/cortex.git"
  },
  "keywords": [
    "cortex",
    "focus",
    "wellbeing",
    "biofeedback",
    "cognitive load",
    "breathing"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The daemon URL is machine-scoped and only loopback hosts are accepted; untrusted workspaces cannot redirect editor context or the local auth token.",
      "restrictedConfigurations": [
        "cortex.daemonUrl"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.20.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "cortex.getActiveFile",
        "title": "Cortex: Get Active File Info"
      },
      {
        "command": "cortex.getDiagnostics",
        "title": "Cortex: Get Current File Diagnostics"
      },
      {
        "command": "cortex.getSymbolAtCursor",
        "title": "Cortex: Get Symbol at Cursor"
      },
      {
        "command": "cortex.foldExcept",
        "title": "Cortex: Fold Except Range"
      },
      {
        "command": "cortex.unfoldAll",
        "title": "Cortex: Unfold All"
      },
      {
        "command": "cortex.restoreFoldState",
        "title": "Cortex: Restore Fold State"
      },
      {
        "command": "cortex.showPanel",
        "title": "Cortex: Show Intervention Panel"
      },
      {
        "command": "cortex.connect",
        "title": "Cortex: Connect to Daemon"
      },
      {
        "command": "cortex.disconnect",
        "title": "Cortex: Disconnect from Daemon"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cortex.getActiveFile",
          "when": "false"
        },
        {
          "command": "cortex.getDiagnostics",
          "when": "false"
        },
        {
          "command": "cortex.getSymbolAtCursor",
          "when": "false"
        },
        {
          "command": "cortex.foldExcept",
          "when": "false"
        },
        {
          "command": "cortex.unfoldAll",
          "when": "false"
        },
        {
          "command": "cortex.restoreFoldState",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortex-sidebar",
          "title": "Cortex",
          "icon": "media/cortex.svg"
        }
      ]
    },
    "views": {
      "cortex-sidebar": [
        {
          "type": "webview",
          "id": "cortex.interventionPanel",
          "name": "Cortex Intervention"
        }
      ]
    },
    "configuration": {
      "title": "Cortex",
      "properties": {
        "cortex.daemonUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:9473",
          "scope": "machine",
          "description": "WebSocket URL of the local Cortex daemon. Only loopback hosts are accepted (ws://127.0.0.1, ws://localhost, ws://[::1]); other hosts are refused because the connection carries the local auth token and editor content."
        },
        "cortex.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to daemon on startup"
        },
        "cortex.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Cortex state in the status bar"
        },
        "cortex.shareEditorContent": {
          "type": "boolean",
          "default": true,
          "description": "Send the visible code of the active file to the local Cortex daemon when it asks for editor context. When off, only the file path, visible line range, symbol name and diagnostics are shared."
        },
        "cortex.shareUntitledDocuments": {
          "type": "boolean",
          "default": false,
          "description": "Also share unsaved (untitled) documents as editor context. Off by default; other non-file documents (output panels, settings, diffs) are never shared."
        },
        "cortex.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose diagnostic logs from the Cortex extension (COPILOT_THROTTLE tracer lines, WS reconnect noise). Off by default."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --runInBand --testPathPatterns='src/__tests__'",
    "package:vsix": "vsce package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/__tests__"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/__mocks__/"
    ],
    "moduleNameMapper": {
      "^vscode$": "<rootDir>/src/__tests__/__mocks__/vscode.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.136.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.9.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "qs": "^6.16.0"
  }
}
