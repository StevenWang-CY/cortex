{
  "name": "cortex-browser-extension",
  "displayName": "Cortex — Somatic Workspace Engine",
  "version": "0.3.13",
  "packageManager": "pnpm@9.15.9",
  "description": "Real-time biofeedback workspace engine for Chrome.",
  "scripts": {
    "dev": "plasmo dev",
    "dev:chrome": "plasmo dev",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "build": "plasmo build",
    "build:chrome": "plasmo build",
    "build:edge": "plasmo build --target=edge-mv3",
    "package": "plasmo package",
    "package:chrome": "plasmo package",
    "package:edge": "plasmo build --target=edge-mv3",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@plasmohq/prettier-plugin-sort-imports": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "@babel/traverse@<7.23.2": "7.23.2",
      "content-security-policy-parser@<0.6.0": "0.6.0",
      "esbuild@<=0.24.2": "0.25.0",
      "msgpackr@<1.10.1": "1.10.1",
      "sharp@<0.35.0": "0.35.0"
    }
  },
  "manifest": {
    "key": "",
    "permissions": [
      "activeTab",
      "scripting",
      "tabs",
      "tabGroups",
      "storage",
      "alarms",
      "bookmarks",
      "webNavigation",
      "nativeMessaging",
      "notifications"
    ],
    "optional_host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "commands": {
      "pause-cortex": {
        "suggested_key": {
          "default": "Ctrl+Shift+P",
          "mac": "Command+Shift+P"
        },
        "description": "Pause / resume Cortex"
      },
      "dismiss-overlay": {
        "suggested_key": {
          "default": "Ctrl+Shift+D",
          "mac": "Command+Shift+D"
        },
        "description": "Dismiss active Cortex overlay"
      },
      "view-history": {
        "suggested_key": {
          "default": "Ctrl+Shift+H",
          "mac": "Command+Shift+H"
        },
        "description": "Open Cortex dashboard history"
      }
    }
  }
}
