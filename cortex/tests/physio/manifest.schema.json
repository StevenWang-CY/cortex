{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StevenWang-CY/cortex/blob/main/cortex/tests/physio/manifest.schema.json",
  "title": "Cortex physiology replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_name",
    "dataset_version",
    "license_name",
    "license_url",
    "source_url",
    "citation",
    "data_use_notes",
    "reference_sensor",
    "clock_alignment_method",
    "participant_data_committed",
    "sequences"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "dataset_name": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "license_name": { "type": "string", "minLength": 1 },
    "license_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "citation": { "type": "string", "minLength": 1 },
    "data_use_notes": { "type": "string", "minLength": 1 },
    "reference_sensor": { "type": "string", "minLength": 1 },
    "clock_alignment_method": { "type": "string", "minLength": 1 },
    "participant_data_committed": { "const": false },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "sequence_id",
          "split",
          "path",
          "sha256",
          "sample_rate_hz",
          "condition"
        ],
        "properties": {
          "subject_id": { "type": "string", "minLength": 1 },
          "sequence_id": { "type": "string", "minLength": 1 },
          "split": { "enum": ["development", "evaluation"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sample_rate_hz": { "type": "number", "minimum": 1, "maximum": 240 },
          "condition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
