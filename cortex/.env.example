# [eval]
# CORTEX_EVAL__POLICY=deterministic
# CORTEX_EVAL__DECISION_INTERVAL_SECONDS=60
# CORTEX_EVAL__PRODUCTION__PREFERRED_LOW_FRICTION_ARM=
# CORTEX_EVAL__OUTCOME__REWARD_WINDOW_SECONDS=300
# CORTEX_EVAL__OUTCOME__REWARD_VERSION=helpfulness-v2
# CORTEX_EVAL__OUTCOME__COLLECTOR_INTERVAL_SECONDS=5.0
# CORTEX_EVAL__RESEARCH__ENABLED=false
# CORTEX_EVAL__RESEARCH__STUDY_ID=
# CORTEX_EVAL__RESEARCH__STUDY_EPOCH=
# CORTEX_EVAL__RESEARCH__CONSENT_VERSION=
# CORTEX_EVAL__RESEARCH__SEED_HEX=
# CORTEX_EVAL__RESEARCH__ACTION_CATALOG=["no_action","suggest_only"]
# CORTEX_EVAL__RESEARCH__MINIMUM_PROBABILITY=0.1
# CORTEX_EVAL__RESEARCH__BOOTSTRAP_SAMPLES=1000
# CORTEX_EVAL__RESEARCH__ANALYSIS_SEED=0
# CORTEX_EVAL__RESEARCH__ELIGIBILITY_RULE=Eligible when the reviewed deterministic trigger gate passes and both MRT arms remain safe and feasible.
# CORTEX_EVAL__RESEARCH__AVAILABILITY_RULE=Available when the receptivity gate passes, no repeated-dismissal suppression is active, and no other safety exclusion applies.
# CORTEX_EVAL__RESEARCH__MISSING_OUTCOME_RULE=Retain the decision point, mark the proximal outcome censored, and exclude it from the complete-case primary analysis.
# CORTEX_EVAL__RESEARCH__CONTAMINATION_RULE=Retain the decision point, record every overlapping delivery, and exclude a contaminated proximal window from the primary analysis.
# CORTEX_EVAL__RESEARCH__ONLINE_LEARNING=false
# CORTEX_EVAL__POLICY_DIAGNOSTICS__ENABLED=true
# CORTEX_EVAL__POLICY_DIAGNOSTICS__NIGHTLY_HOUR_LOCAL=2

# [launcher]
# CORTEX_LAUNCHER__USER_COMMAND_ALLOWLIST=[]

# Build, installer, and operational variables
# CORTEX_ENV=dev
# CORTEX_DEBUG=0
# CORTEX_JSON2TS_CMD=/opt/homebrew/bin/json2ts
# CORTEX_NATIVE_HOST_PROJECT_ROOTS=/path/to/cortex
# CORTEX_NATIVE_HOST_PYTHON=/path/to/python3
# CORTEX_PROJECT_ROOT=/path/to/cortex
# CORTEX_PYTHON=/path/to/python3
# CORTEX_SIGN_IDENTITY=Developer ID Application: Example (TEAMID)
# CORTEX_NOTARIZE_PROFILE=cortex-notary
# CORTEX_NOTARIZE_KEYCHAIN=/path/to/signing.keychain-db
# CORTEX_REQUIRE_NOTARIZATION=1
# CORTEX_ARTIFACT_ARCH=arm64
# CORTEX_RELEASE_EVIDENCE_DIR=dist/evidence
# CORTEX_RELEASE_TAG=v0.3.5
# CORTEX_SKIP_EXT_BUILD=0
# CORTEX_SKIP_VSCODE_EXT_BUILD=0
# CORTEX_ROOT=/path/to/cortex

# Provider credentials (prefer Keychain/ADC)
# AWS_BEARER_TOKEN_BEDROCK=
# ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
